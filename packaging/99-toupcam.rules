# ToupTek / OMAX USB cameras (vendor ids 0x0547 and 0x04b4, as in the 2026 SDK): allow non-root access.
# Install: sudo cp 99-toupcam.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# then unplug and re-plug the camera. Tighten MODE/GROUP if 0666 is too loose for your setup.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0547", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04b4", MODE="0666"
